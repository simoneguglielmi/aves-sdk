# AVES SDK Example Environment Variables
# Copy this file to ".env" and fill in your real values.

# Base URL of the AVES REST API (e.g., https://api.example.com)
AVES_BASE_URL=

# 6-digit Host ID provided by AVES
AVES_HOST_ID=

# AVES Xtoken authorization string
AVES_XTOKEN=

# Optional language code for tag descriptions (e.g., 1 = Italian, 2 = English)
AVES_LANGUAGE_CODE=

