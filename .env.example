# AVES SDK Example Environment Variables
# Copy this file to ".env" and fill in your real values.

# Base URL of the AVES REST API (e.g., https://api.example.com)
AVES_BASE_URL=

# 6-digit Host ID provided by AVES
AVES_HOST_ID=

# AVES Xtoken authorization string
AVES_XTOKEN=

# Optional 2-digit AVES language code for tag descriptions (01 = Italian, 02 = English)
AVES_LANGUAGE_CODE=

