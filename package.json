{
  "name": "aves-sdk",
  "version": "1.2.12",
  "description": "TypeScript SDK for AVES XML REST",
  "homepage": "https://github.com/simoneguglielmi/aves-sdk#readme",
  "repository": [
    {
      "type": "git",
      "url": "git+https://github.com/simoneguglielmi/aves-sdk.git"
    },
    {
      "type": "npm",
      "url": "https://npmjs.com/package/aves-sdk"
    }
  ],
  "bugs": {
    "url": "https://github.com/simoneguglielmi/aves-sdk/issues"
  },
  "keywords": [
    "aves",
    "sdk",
    "xml",
    "rest",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "yarn clean && yarn tsup",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "prepare": "yarn build",
    "test": "vitest run",
    "publish": "npm publish"
  },
  "packageManager": "yarn@1.22.22",
  "dependencies": {
    "fast-xml-parser": "^5.3.3",
    "undici": "^7.18.2",
    "valibot": "^1.2.0"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^24.6.2",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "eslint": "^9.39.2",
    "rimraf": "^6.1.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  }
}
