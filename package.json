{
  "name": "aves-sdk",
  "version": "1.2.3",
  "description": "TypeScript SDK for AVES XML REST",
  "homepage": "https://github.com/simoneguglielmi/aves-sdk#readme",
  "repository": [
    {
      "type": "git",
      "url": "git+https://github.com/simoneguglielmi/aves-sdk.git"
    },
    {
      "type": "npm",
      "url": "https://npmjs.com/package/aves-sdk"
    }
  ],
  "bugs": {
    "url": "https://github.com/simoneguglielmi/aves-sdk/issues"
  },
  "keywords": [
    "aves",
    "sdk",
    "xml",
    "rest",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "yarn clean && yarn tsup",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "prepare": "yarn build",
    "test": "vitest run",
    "publish": "npm publish"
  },
  "packageManager": "yarn@1.22.22",
  "dependencies": {
    "fast-xml-parser": "^5.3.0",
    "undici": "^7.18.2",
    "valibot": "^1.2.0"
  },
  "devDependencies": {
    "@swc/core": "^1.13.5",
    "@types/node": "^24.6.2",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "eslint": "^9.37.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "dts": {
      "resolve": true,
      "tsconfig": "tsconfig.build.json"
    },
    "format": [
      "cjs",
      "esm"
    ],
    "sourcemap": true,
    "clean": true,
    "minify": true
  }
}
