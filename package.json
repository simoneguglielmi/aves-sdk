{
  "name": "aves-sdk",
  "version": "1.0.3",
  "description": "TypeScript SDK for AVES XML REST, compatible with NestJS",
  "homepage": "https://github.com/simoneguglielmi/aves-sdk#readme",
  "repository": [{
    "type": "git",
    "url": "git+https://github.com/simoneguglielmi/aves-sdk.git"
  },{
    "type": "npm",
    "url": "https://npmjs.com/package/aves-sdk"
  }],
  "bugs": {
    "url": "https://github.com/simoneguglielmi/aves-sdk/issues"
  },
  "keywords": [
    "aves",
    "sdk",
    "xml",
    "rest",
    "nestjs",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "yarn clean && yarn tsup",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "prepare": "yarn build",
    "test": "vitest run"
  },
  "packageManager": "yarn@1.22.22",
  "peerDependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^10.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.11"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "axios": "^1.12.2",
    "fast-xml-parser": "^5.3.0"
  },
  "devDependencies": {
    "@nestjs/config": "^4.0.2",
    "@swc/core": "^1.13.5",
    "@types/node": "^24.6.2",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "eslint": "^9.37.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "zod": "^4.1.11"
  },
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "dts": {
      "resolve": true,
      "tsconfig": "tsconfig.build.json"
    },
    "format": [
      "cjs",
      "esm"
    ],
    "sourcemap": true,
    "clean": true,
    "minify": true
  }
}
