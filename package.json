{
  "name": "aves-sdk",
  "version": "5.0.1",
  "description": "TypeScript SDK for AVES XML REST",
  "homepage": "https://github.com/simoneguglielmi/aves-sdk#readme",
  "repository": [
    {
      "type": "git",
      "url": "git+https://github.com/simoneguglielmi/aves-sdk.git"
    },
    {
      "type": "npm",
      "url": "https://npmjs.com/package/aves-sdk"
    }
  ],
  "bugs": {
    "url": "https://github.com/simoneguglielmi/aves-sdk/issues"
  },
  "keywords": [
    "aves",
    "sdk",
    "xml",
    "rest",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist/index.mjs",
    "dist/index.d.mts",
    "dist/CHANGELOG.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm clean && pnpm lint && pnpm typecheck && pnpm tsdown",
    "prepare": "pnpm build",
    "test": "vitest run",
    "test:types": "vitest run --typecheck.only",
    "test:bench": "vitest bench",
    "test:perf": "AVES_PERF=1 vitest run src/utils/hot-path.perf.test.ts",
    "lint": "biome check src",
    "check": "biome check --write src",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "pnpm@12.14.0",
  "dependencies": {
    "@effect/platform": "^0.97.2",
    "effect": "^3.22.2",
    "fast-xml-builder": "^1.3.1",
    "fast-xml-parser": "^5.11.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^26.6.5",
    "rimraf": "^6.1.3",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
