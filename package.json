{
  "name": "aves-sdk",
  "version": "3.0.0",
  "description": "TypeScript SDK for AVES XML REST",
  "homepage": "https://github.com/simoneguglielmi/aves-sdk#readme",
  "repository": [
    {
      "type": "git",
      "url": "git+https://github.com/simoneguglielmi/aves-sdk.git"
    },
    {
      "type": "npm",
      "url": "https://npmjs.com/package/aves-sdk"
    }
  ],
  "bugs": {
    "url": "https://github.com/simoneguglielmi/aves-sdk/issues"
  },
  "keywords": [
    "aves",
    "sdk",
    "xml",
    "rest",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist/index.mjs",
    "dist/index.d.mts",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "yarn clean && yarn lint && yarn typecheck && yarn tsdown",
    "prepare": "yarn build",
		"test": "vitest run",
		"test:types": "vitest run --typecheck.only",
		"test:bench": "vitest bench",
		"test:perf": "AVES_PERF=1 vitest run src/utils/hot-path.perf.test.ts",
		"publish": "npm publish",
    "lint": "biome check src",
    "check": "biome check --write src",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "yarn@1.22.22",
  "dependencies": {
    "fast-xml-builder": "^1.3.0",
    "fast-xml-parser": "^5.10.1",
    "undici": "^8.10.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^26.1.2",
    "dotenv": "^17.4.2",
    "rimraf": "^6.1.3",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
